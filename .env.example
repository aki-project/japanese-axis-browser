# Postgres connection. When unset, the API and pipeline use an embedded PGlite
# database under data/pglite/ so local dev works without a Postgres daemon.
DATABASE_URL=postgres://japanesesite:japanesesite@localhost:5432/japanesesite
# Docker Compose Postgres. Set POSTGRES_PASSWORD before the first
# `docker compose up` (and match it in DATABASE_URL); POSTGRES_PORT if 5432 is taken.
# POSTGRES_PASSWORD=japanesesite
# POSTGRES_PORT=5432
API_PORT=3001
# Hostnames `vite preview` answers to, comma-separated; a leading dot allows
# a domain and its subdomains. Needed only when a reverse proxy passes the
# public hostname through (Apache: ProxyPreserveHost On). See README, Quick deploy.
# PREVIEW_ALLOWED_HOSTS=jp.example.com
